DJANGO_SETTINGS_MODULE=settings-mode            # <- use cityscope.settings.local for local development and use cityscope.settings.production for production
DJANGO_DEBUG=true-or-false-for-debug-mode       # <- use 1 for True and 0 for False
SECRET_KEY=your-django-secret-key
POSTGRES_DB=name-of-your-db
POSTGRES_USER=username-of-your-db
POSTGRES_PASSWORD=password-of-your-db
POSTGRES_HOST=cityscope-postgres                # <- name of db container
POSTGRES_PORT=5432
REDIS_HOST=redis
OVERPASS_API_ENDPOINT=your-overpass-endpoint    # <- for example "https://overpass.private.coffee/api/interpreter"
ALLOWED_HOSTS=your-api-domain                   # <- production only, comma-separated
AUTH_COOKIE_DOMAIN=your-shared-domain           # <- production only, for example ".example.com"
CORS_ALLOWED_ORIGINS=your-frontend-origin       # <- production only, for example "https://app.example.com"
CSRF_TRUSTED_ORIGINS=your-frontend-origin       # <- production only, for example "https://app.example.com"
